#: data/appdata/org.gnome.ColorProfileViewer.metainfo.xml.in:7
msgid "GNOME Color Manager"
msgstr "ຕົວຈັດການສີ GNOME"

#: data/appdata/org.gnome.ColorProfileViewer.metainfo.xml.in:8
msgid "The GNOME Project"
msgstr "ໂຄງການ GNOME"

#: data/appdata/org.gnome.ColorProfileViewer.metainfo.xml.in:12
#: data/org.gnome.ColorProfileViewer.desktop.in:3
msgid "Inspect and compare installed color profiles"
msgstr "ກວດສອບ ແລະ ປຽບທຽບໂປຣໄຟລ໌ສີທີ່ຕິດຕັ້ງໄວ້"

#: data/appdata/org.gnome.ColorProfileViewer.metainfo.xml.in:14
msgid ""
"GNOME Color Profile Viewer shows installed color profiles on your system and "
"allows you to calibrate displays, printers and cameras using a wizard."
msgstr ""
"ຕົວເບິ່ງໂປຣໄຟລ໌ສີ GNOME ສະແດງໂປຣໄຟລ໌ສີທີ່ຕິດຕັ້ງຢູ່ໃນລະບົບຂອງທ່ານ ແລະ "
"ຊ່ວຍໃຫ້ທ່ານສາມາດປັບທຽບໜ້າຈໍ, ເຄື່ອງພິມ ແລະ ກ້ອງຖ່າຍຮູບ ໂດຍໃຊ້ຕົວຊ່ວຍຕັ້ງຄ່າ."

#: data/appdata/org.gnome.ColorProfileViewer.metainfo.xml.in:19
msgid ""
"This functionality is typically used by GNOME Control Center from the color "
"panel although can be used on its own."
msgstr ""
"ໂດຍປົກກະຕິແລ້ວ ຟັງຊັນນີ້ແມ່ນໃຊ້ໂດຍ ສູນຄວບຄຸມ GNOME ຈາກແຜງຄວບຄຸມສີ "
"ເຖິງວ່າຈະສາມາດໃຊ້ງານໄດ້ດ້ວຍຕົວມັນເອງກໍຕາມ."

#: data/gcm-import.desktop.in:2
msgid "ICC Profile Installer"
msgstr "ຕົວຕິດຕັ້ງໂປຣໄຟລ໌ ICC"

#: data/gcm-import.desktop.in:3
msgid "Install ICC profiles"
msgstr "ຕິດຕັ້ງໂປຣໄຟລ໌ ICC"

#. Window title, where the user can pick spot colors using a measuring device
#: data/gcm-picker.desktop.in:2 src/gcm-picker.ui:27 src/gcm-picker.ui:324
msgid "Color Picker"
msgstr "ເຄື່ອງເລືອກສີ"

#: data/gcm-picker.desktop.in:3
msgid "Use the color sensor to sample spot colors"
msgstr "ໃຊ້ເຊັນເຊີສີເພື່ອສຸ່ມຕົວຢ່າງສີສະເພາະຈຸດ"

#: data/org.gnome.ColorProfileViewer.desktop.in:2 src/gcm-viewer.ui:1155
msgid "Color Profile Viewer"
msgstr "ຕົວເບິ່ງໂປຣໄຟລ໌ສີ"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.ColorProfileViewer.desktop.in:12
msgid "Color;ICC;"
msgstr "ສີ;Color;ICC;"

